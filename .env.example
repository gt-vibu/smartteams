# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=https://api.invalid.smarteam.example
WEB_ORG_URL=https://app.invalid.smarteam.example
WEB_ADMIN_URL=https://admin.invalid.smarteam.example
CORS_ORIGINS=https://app.invalid.smarteam.example,https://admin.invalid.smarteam.example
TRUST_PROXY_HOPS=1

# PostgreSQL
DATABASE_URL=postgresql://invalid_user:invalid_password@invalid-postgres.invalid:5432/invalid_database?schema=public
SHADOW_DATABASE_URL=postgresql://invalid_shadow_user:invalid_shadow_password@invalid-postgres.invalid:5432/invalid_shadow_database?schema=public
DATABASE_SYSTEM_URL=postgresql://invalid_system_user:invalid_system_password@invalid-postgres.invalid:5432/invalid_database?schema=public
DATABASE_PLATFORM_URL=postgresql://invalid_platform_user:invalid_platform_password@invalid-postgres.invalid:5432/invalid_database?schema=public

# Redis / BullMQ
REDIS_URL=redis://invalid-redis.invalid:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=smarteam:

# Object storage (S3 API).
#
# The application talks to one S3 API and never branches on the provider. Local development
# points these at MinIO; production points them at AWS S3. Nothing in the source code changes
# between the two — only the four variables below.
#
#   LOCAL       AWS_S3_ENDPOINT=http://localhost:9000  AWS_S3_FORCE_PATH_STYLE=true
#               with an explicit access key / secret pair.
#   PRODUCTION  AWS_S3_ENDPOINT=                       AWS_S3_FORCE_PATH_STYLE=false
#               with the key and secret left empty so the SDK resolves the IAM role.
AWS_REGION=<region>
AWS_S3_BUCKET=<bucket-name>
AWS_S3_ENDPOINT=<s3-endpoint-or-empty-for-aws>
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=<access-key-or-empty-for-iam-role>
AWS_SECRET_ACCESS_KEY=<secret-key-or-empty-for-iam-role>

# Local MinIO only — read by docker compose, ignored by the API.
#
# Uploads are signed with ServerSideEncryption AES256, which MinIO can only honour once it holds
# a master key; without one it answers 501 where real S3 succeeds. Format is <key-name>:<base64
# of 32 random bytes>, generated with `openssl rand -base64 32`. Never commit a real value.
MINIO_ROOT_USER=<local-access-key>
MINIO_ROOT_PASSWORD=<local-secret>
MINIO_KMS_SECRET_KEY=<local-kms-key-name>:<local-kms-secret>

# Native authentication
JWT_ISSUER=smarteam-api
JWT_AUDIENCE=smarteam-app
JWT_SECRET=invalid-jwt-secret-replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_COOKIE_NAME=smarteam_session
SESSION_COOKIE_DOMAIN=invalid.smarteam.example
SESSION_COOKIE_SECURE=false
# lax suits api./app./admin. on one registrable domain and localhost in development.
# Set to none only for a genuinely cross-site deployment; that requires SECURE=true.
SESSION_COOKIE_SAME_SITE=lax
PASSWORD_HASH_MEMORY_COST=19456
SUPERADMIN_EMAIL=admin@example.invalid
SUPERADMIN_PASSWORD=replace-with-a-local-password-at-least-12-characters

# Federation platform bootstrap and request security
FEDERATION_TOKEN_TTL_SECONDS=900
FEDERATION_REQUEST_CLOCK_SKEW_SECONDS=300
FEDERATION_NONCE_TTL_SECONDS=300
FEDERATION_BOOTSTRAP_SECRET=invalid-bootstrap-secret-replace-me
FEDERATION_WEBHOOK_SIGNING_KEY_ID=invalid-signing-key-id
FEDERATION_WEBHOOK_SIGNING_PRIVATE_KEY_PEM=invalid-signing-private-key-replace-me
FEDERATION_WEBHOOK_SIGNING_PUBLIC_KEY_PEM=invalid-signing-public-key-replace-me
FEDERATION_WEBHOOK_RETRY_WINDOW_SECONDS=259200
FEDERATION_IDEMPOTENCY_ENCRYPTION_KEY=<32-byte-encryption-key>
FEDERATION_RATE_LIMIT_PER_MINUTE=invalid-rate-limit
FEDERATION_TOKEN_RATE_LIMIT_PER_MINUTE=invalid-token-rate-limit
FEDERATION_WEBHOOK_ALLOWED_HOSTS=invalid-blizbooks.invalid
AUTH_RATE_LIMIT_PER_MINUTE=invalid-auth-rate-limit
FILE_DELETION_RETENTION_DAYS=invalid-retention-days

# WebAuthn / passkey attendance verification
WEBAUTHN_RP_ID=invalid.smarteam.example
WEBAUTHN_ORIGIN=https://invalid.smarteam.example
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Observability
#
# Only METRICS_TOKEN is read: it guards /metrics and is required outside development.
# There is no tracing or error-reporting integration, so no variables are listed for one.
METRICS_TOKEN=<metrics-bearer-token-at-least-32-chars>
SWAGGER_ENABLED=true

# Public frontend configuration
NEXT_PUBLIC_SESSION_COOKIE_NAME=smarteam_session
NEXT_PUBLIC_API_URL=https://api.invalid.smarteam.example
NEXT_PUBLIC_APP_ENV=development
