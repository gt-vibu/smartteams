# Testing the workspace on a phone through a tunnel (ngrok, Cloudflare Tunnel).
#
# Copy to `.env.local` in this directory (it is gitignored), put your tunnel's host on the first
# line, and restart `pnpm dev`. Then run the tunnel against port 3000 only — the API is reached
# through this server, so it needs no tunnel of its own. See `next.config.ts` for why each is needed.

# Your tunnel's host, no scheme. Comma-separate several. Not a wildcard: see next.config.ts.
DEV_TUNNEL_HOSTS=your-subdomain.ngrok-free.dev

# Forward /v1/* from this server to the API running on this machine.
API_PROXY_TARGET=http://localhost:4000

# Empty on purpose: the browser then calls /v1/* on whatever origin served the page.
NEXT_PUBLIC_API_URL=
