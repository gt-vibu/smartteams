{
  "name": "@smarteam/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/prisma-generate.mjs && nest build",
    "clean": "rm -rf dist src/generated",
    "db:generate": "node scripts/prisma-generate.mjs --force",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:diff": "prisma migrate diff",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "typecheck": "node scripts/prisma-generate.mjs && tsc -p tsconfig.json --noEmit",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "db:provision-runtime-role": "node scripts/provision-runtime-role.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/s3-request-presigner": "3.1114.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "prisma": "7.9.1",
    "@simplewebauthn/server": "13.3.2",
    "@smarteam/config": "workspace:*",
    "@smarteam/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.1.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
