/// A day off earned by working a weekly off or a holiday. Approved, it is credited to the
/// organization's comp-off leave type; unused, it lapses after that type's expiry.
model CompOffCredit {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  leaveTypeId     String         @map("leave_type_id") @db.Uuid
  workDate        DateTime       @map("work_date") @db.Date
  /// 0.5 or 1.
  days            Decimal        @db.Decimal(4, 1)
  reason          String
  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionComment String?        @map("decision_comment")
  /// The last day it can be used; set when approved.
  expiresOn       DateTime?      @map("expires_on") @db.Date
  /// Whatever was still unused when it lapsed.
  lapsedDays      Decimal?       @map("lapsed_days") @db.Decimal(4, 1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, workDate])
  @@index([organizationId, status, expiresOn])
  @@map("comp_off_credits")
}

/// Unused leave exchanged for pay. Approved, the days leave the balance and the amount is added
/// to the employee's next payroll run.
model LeaveEncashment {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  leaveTypeId     String         @map("leave_type_id") @db.Uuid
  days            Decimal        @db.Decimal(6, 1)
  /// Worked out when approved: the day rate times the days.
  amount          Decimal?       @db.Decimal(14, 2)
  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionComment String?        @map("decision_comment")
  payrollRunId    String?        @map("payroll_run_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@map("leave_encashments")
}

/// A field the organization adds to every employee record: a T-shirt size, a vehicle number.
model CustomFieldDefinition {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  key              String
  label            String
  /// TEXT, NUMBER, DATE or SELECT.
  fieldType        String   @map("field_type")
  options          String[]
  required         Boolean  @default(false)
  /// Whether the employee sees and edits it on their own profile.
  employeeEditable Boolean  @default(false) @map("employee_editable")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("custom_field_definitions")
}
