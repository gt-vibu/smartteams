model EmployeePayrollPolicy {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  employeeId            String         @map("employee_id") @db.Uuid
  payrollPolicyId       String?        @map("payroll_policy_id") @db.Uuid
  assignmentSource      String         @default("ORGANIZATION_DEFAULT") @map("assignment_source")
  assignmentRuleId      String?        @map("assignment_rule_id") @db.Uuid
  effectiveFrom         DateTime       @map("effective_from") @db.Date
  effectiveTo           DateTime?      @map("effective_to") @db.Date
  payrollEnabled        Boolean        @default(true) @map("payroll_enabled")
  salarySlipMode        SalarySlipMode @default(ENABLED) @map("salary_slip_mode")
  pfEnabled             Boolean        @default(false) @map("pf_enabled")
  esiEnabled            Boolean        @default(false) @map("esi_enabled")
  ptEnabled             Boolean        @default(false) @map("pt_enabled")
  statutoryJurisdiction String?        @map("statutory_jurisdiction")
  metadata              Json           @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollPolicy  PayrollPolicy?               @relation(fields: [payrollPolicyId], references: [id], onDelete: Restrict)
  assignmentRule PayrollPolicyAssignmentRule? @relation(fields: [assignmentRuleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, employeeId, effectiveFrom])
  @@index([assignmentRuleId])
  @@map("employee_payroll_policies")
}

model EmployeeStatutoryProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  schemeCode         String    @map("scheme_code")
  registrationNumber String?   @map("registration_number")
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  employeeRate       Decimal?  @map("employee_rate") @db.Decimal(8, 4)
  employerRate       Decimal?  @map("employer_rate") @db.Decimal(8, 4)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, schemeCode, effectiveFrom])
  @@map("employee_statutory_profiles")
}

model EmployeeStatutoryRecord {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  employeeId      String                 @map("employee_id") @db.Uuid
  schemeCode      String                 @map("scheme_code")
  periodStart     DateTime               @map("period_start") @db.Date
  periodEnd       DateTime               @map("period_end") @db.Date
  status          ComplianceRecordStatus @default(DRAFT)
  employeeAmount  Decimal?               @map("employee_amount") @db.Decimal(14, 2)
  employerAmount  Decimal?               @map("employer_amount") @db.Decimal(14, 2)
  dueDate         DateTime?              @map("due_date") @db.Date
  submittedAt     DateTime?              @map("submitted_at") @db.Timestamptz(6)
  filingReference String?                @map("filing_reference")
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int                    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, schemeCode, periodStart, periodEnd])
  @@index([organizationId, schemeCode, periodStart, status])
  @@map("employee_statutory_records")
}
