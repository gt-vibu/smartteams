generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationSource {
  NATIVE
  BLIZBOOKS
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum IdentityType {
  NATIVE
  FEDERATED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AccessMode {
  NATIVE
  FEDERATION
  PLATFORM
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum FederationClientStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GrantEffect {
  ALLOW
  DENY
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  CORRECTED
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  RELEASED
  LOCKED
  CORRECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  source              OrganizationSource
  externalId          String?            @db.Uuid
  status              OrganizationStatus @default(ACTIVE)
  timezone            String             @default("UTC")
  currencyCode        String             @db.Char(3)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deactivatedAt       DateTime?
  branches            Branch[]
  users               UserOrganization[]
  userRoles           UserRole[]
  employees           Employee[]
  roles               Role[]
  attendanceRecords   Attendance[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  timesheets          Timesheet[]
  shifts              Shift[]
  payrollRuns         PayrollRun[]
  federationGrants   FederationGrant[]
  webhookSubscriptions WebhookSubscription[]
  outboxEvents        OutboxEvent[]
  auditLogs           AuditLog[]
  files               FileObject[]

  @@unique([source, externalId])
  @@index([status])
}

model Branch {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  source         OrganizationSource
  externalId     String?            @db.Uuid
  status         OrganizationStatus @default(ACTIVE)
  timezone       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  timesheets     Timesheet[]
  shifts         Shift[]
  grants         FederationGrant[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  email                  String             @unique
  passwordHash           String?
  identityType           IdentityType       @default(NATIVE)
  externalIdentityId     String?            @unique @db.Uuid
  platformRole           PlatformRole?
  isActive               Boolean            @default(true)
  tokenVersion           Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organizations          UserOrganization[]
  employee               Employee?
  roles                  UserRole[]
  auditLogs              AuditLog[]
  files                  FileObject[]

  @@index([identityType, isActive])
}

model UserOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @db.Uuid
  name           String
  description    String?
  isSystem       Boolean      @default(false)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId, isSystem])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  organizationId String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, organizationId])
  @@index([organizationId])
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  primaryBranchId String?       @db.Uuid
  userId         String?        @unique @db.Uuid
  name           String
  identitySource IdentityType
  externalId     String?        @db.Uuid
  status         EmployeeStatus @default(ACTIVE)
  employmentType String?
  dateOfJoining  DateTime?
  ownedFields    Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryBranch  Branch?        @relation(fields: [primaryBranchId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance     Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  timesheets     Timesheet[]
  assignments    EmployeeShift[]
  payrollLines   PayrollLineItem[]
  files          FileObject[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  branchId       String?          @db.Uuid
  employeeId     String           @db.Uuid
  workDate       DateTime         @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         AttendanceStatus @default(OPEN)
  source         AccessMode
  correctionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, workDate])
  @@index([organizationId, workDate])
}

model LeaveType {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  paid           Boolean      @default(true)
  annualAllowance Decimal?     @db.Decimal(12, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances       LeaveBalance[]
  requests       LeaveRequest[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  employeeId     String       @db.Uuid
  leaveTypeId    String       @db.Uuid
  periodYear     Int
  available     Decimal      @db.Decimal(12, 2)
  used           Decimal      @default(0) @db.Decimal(12, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, periodYear])
  @@index([organizationId, periodYear])
}

model LeaveRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  branchId       String?           @db.Uuid
  employeeId     String            @db.Uuid
  leaveTypeId    String            @db.Uuid
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  days           Decimal           @db.Decimal(8, 2)
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  source         AccessMode
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType      LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, startDate])
}

model Timesheet {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  branchId       String?        @db.Uuid
  employeeId     String         @db.Uuid
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  totalMinutes   Int            @default(0)
  status         TimesheetStatus @default(DRAFT)
  source         AccessMode
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([organizationId, status, periodStart])
}

model Shift {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String?         @db.Uuid
  name           String
  startsAt       String
  endsAt         String
  breakMinutes   Int             @default(0)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignments    EmployeeShift[]

  @@index([organizationId, branchId])
}

model EmployeeShift {
  employeeId String   @db.Uuid
  shiftId    String   @db.Uuid
  startsOn   DateTime @db.Date
  endsOn     DateTime? @db.Date
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([employeeId, shiftId, startsOn])
}

model PayrollRun {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  status         PayrollRunStatus @default(DRAFT)
  calculationHash String?
  calculatedAt   DateTime?
  releasedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines          PayrollLineItem[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

model PayrollLineItem {
  id             String       @id @default(uuid()) @db.Uuid
  payrollRunId   String       @db.Uuid
  employeeId     String       @db.Uuid
  grossAmount    Decimal      @db.Decimal(14, 2)
  deductions     Decimal      @db.Decimal(14, 2)
  netAmount      Decimal      @db.Decimal(14, 2)
  breakdown      Json         @default("{}")
  payrollRun     PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
}

model FederationClient {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  clientId          String                 @unique
  clientSecretHash  String
  status            FederationClientStatus @default(ACTIVE)
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  revokedAt         DateTime?
  grants            FederationGrant[]
  subscriptions     WebhookSubscription[]
  outboxEvents      OutboxEvent[]
  auditLogs         AuditLog[]
  idempotencyRecords IdempotencyRecord[]
}

model FederationGrant {
  id             String           @id @default(uuid()) @db.Uuid
  clientId       String           @db.Uuid
  organizationId String           @db.Uuid
  branchId       String?          @db.Uuid
  scope          String
  effect         GrantEffect      @default(ALLOW)
  client         FederationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([clientId, organizationId, branchId, scope])
  @@index([organizationId, branchId])
}

model WebhookSubscription {
  id             String           @id @default(uuid()) @db.Uuid
  clientId       String           @db.Uuid
  organizationId String           @db.Uuid
  callbackUrl    String
  eventTypes     String[]
  signingKeyId   String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  client         FederationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([clientId, organizationId])
}

model OutboxEvent {
  id             String           @id @default(uuid()) @db.Uuid
  eventId        String           @unique @db.Uuid
  organizationId String           @db.Uuid
  clientId       String?          @db.Uuid
  eventType      String
  aggregateType  String
  aggregateId    String
  aggregateVersion Int
  payload        Json
  status         OutboxStatus     @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client         FederationClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([organizationId, eventType, createdAt])
}

model IdempotencyRecord {
  id             String           @id @default(uuid()) @db.Uuid
  clientId       String           @db.Uuid
  organizationId String?          @db.Uuid
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  client         FederationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([createdAt])
}

model AuditLog {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @db.Uuid
  userId         String?           @db.Uuid
  clientId       String?           @db.Uuid
  action         String
  entityType     String
  entityId       String
  accessMode     AccessMode
  correlationId  String
  before         Json?
  after          Json?
  createdAt      DateTime          @default(now())
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  client         FederationClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model FileObject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  uploadedById   String?      @db.Uuid
  employeeId     String?      @db.Uuid
  objectKey      String       @unique
  bucket         String
  originalName   String
  contentType    String
  byteSize       BigInt
  checksum       String?
  purpose        String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, purpose, createdAt])
}
