{
  "name": "@smarteam/platform",
  "private": true,
  "version": "0.1.0",
  "description": "Smarteam V2 People Management platform",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:deploy": "pnpm --filter @smarteam/api db:deploy",
    "db:diff": "pnpm --filter @smarteam/api db:diff",
    "db:format": "pnpm --filter @smarteam/api db:format",
    "db:generate": "pnpm --filter @smarteam/api db:generate",
    "db:migrate": "pnpm --filter @smarteam/api db:migrate",
    "db:seed": "pnpm --filter @smarteam/api db:seed",
    "db:status": "pnpm --filter @smarteam/api db:status",
    "db:studio": "pnpm --filter @smarteam/api db:studio",
    "db:validate": "pnpm --filter @smarteam/api db:validate",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "husky || true",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:employees": "node scripts/verify-employees.mjs",
    "verify:teams": "node scripts/verify-teams-projects.mjs",
    "verify:attendance": "node scripts/verify-attendance.mjs",
    "verify:leave": "node scripts/verify-leave.mjs",
    "verify:payroll": "node scripts/verify-payroll.mjs",
    "verify:organization": "node scripts/verify-organization.mjs",
    "verify:files": "node scripts/verify-files.mjs",
    "verify:holidays": "node scripts/verify-holidays.mjs",
    "verify:employee-detail": "node scripts/verify-employee-detail.mjs",
    "verify:employee-directory": "node scripts/verify-employee-directory.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:payroll-staleness": "node scripts/verify-payroll-staleness.mjs",
    "verify:timesheet-approval-cycle": "node scripts/verify-timesheet-approval-cycle.mjs",
    "verify:authorization-boundaries": "node scripts/verify-authorization-boundaries.mjs",
    "verify:concurrency": "node scripts/verify-concurrency.mjs",
    "verify:ownership-and-approvals": "node scripts/verify-ownership-and-approvals.mjs",
    "verify:missing-checkout": "node scripts/verify-missing-checkout.mjs",
    "verify:holiday-checkin": "node scripts/verify-holiday-checkin.mjs",
    "verify:shift-assignment": "node scripts/verify-shift-assignment.mjs",
    "perf:payroll": "node scripts/perf-payroll.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:verify-restore": "node scripts/verify-restore.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
