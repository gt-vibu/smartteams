{
  "name": "@smarteam/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.tsx",
      "import": "./src/button.tsx",
      "require": "./dist/button.js",
      "default": "./src/button.tsx"
    },
    "./theme.css": {
      "default": "./src/theme.css"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts",
      "require": "./dist/theme.js",
      "default": "./src/theme.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@smarteam/tsconfig": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
