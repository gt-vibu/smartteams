{
  "extends": "@smarteam/tsconfig/base.json",
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
